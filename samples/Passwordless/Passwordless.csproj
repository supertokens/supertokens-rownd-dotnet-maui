<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RowndTargetFrameworks Condition="'$(RowndTargetFrameworks)' == ''">net10.0-android;net10.0-ios</RowndTargetFrameworks>
    <TargetFrameworks>$(RowndTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Passwordless</RootNamespace>
    <UseMaui>true</UseMaui>
    <EnableBlankMauiSplashScreen>true</EnableBlankMauiSplashScreen>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AndroidManifest Condition="'$(RowndAndroidManifest)' != ''">$(RowndAndroidManifest)</AndroidManifest>
    <MauiVersion>10.0.20</MauiVersion>
    <ApplicationTitle>Passwordless foundation</ApplicationTitle>
    <ApplicationId>$(RowndApplicationId)</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <IsPackable>false</IsPackable>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(RowndStartupConfig)" LogicalName="Passwordless.Startup.json" Condition="'$(RowndStartupConfig)' != ''" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="../../src/Rownd.Maui/Rownd.Maui.csproj" Condition="'$(RowndUsePackage)' == 'false'" />
    <PackageReference Include="SuperTokens.Rownd.Maui" Version="0.0.1-m3" Condition="'$(RowndUsePackage)' != 'false'" />
  </ItemGroup>
  <Target Name="ValidateStartupConfig" BeforeTargets="PrepareForBuild" Condition="'$(RowndStartupConfig)' != '' and !Exists('$(RowndStartupConfig)')">
    <Error Text="RowndStartupConfig must point to an existing non-secret startup JSON file." />
  </Target>
  <Target Name="RequireApplicationIdentity" BeforeTargets="PrepareForBuild" Condition="'$(RowndApplicationId)' == ''">
    <Error Text="Pass -p:RowndApplicationId=your.actual.application.id. No customer identity is assumed." />
  </Target>
</Project>
