<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <IsBindingProject>true</IsBindingProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>SuperTokens.Rownd.Native.Android</PackageId>
    <Version>0.0.1-m2</Version>
    <Description>Provisional local native Rownd facade binding.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Remove="StyleCop.Analyzers" />
    <AndroidLibrary Include="../../native/android/build/outputs/aar/mauiFacade-release.aar" />
    <AndroidLibrary Include="../../native/android/build/runtime/android-release.aar" Bind="false" />
    <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.8.1" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>
  <Import Project="../../native/android/build/runtime-libraries.props" Condition="Exists('../../native/android/build/runtime-libraries.props')" />
  <Target Name="RequireNativeFacade" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../../native/android/build/outputs/aar/mauiFacade-release.aar')" Text="Run scripts/build-native-android.sh before building bindings." />
    <Error Condition="!Exists('../../native/android/build/runtime-libraries.props')" Text="Run scripts/build-native-android.sh to resolve runtime packaging." />
  </Target>
</Project>
